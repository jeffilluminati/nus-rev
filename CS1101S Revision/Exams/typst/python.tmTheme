    <dict><key>scope</key><string>string</string>
      <key>settings</key><dict><key>foreground</key><string>#198810</string><key>fontStyle</key><string>italic</string></dict></dict>
    <dict><key>scope</key><string>entity.name, support</string>
      <key>settings</key><dict><key>foreground</key><string>#4b69c6</string><key>fontStyle</key><string>bold</string></dict></dict>
    <dict><key>scope</key><string>comment</string>
