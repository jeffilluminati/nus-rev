    if relation and has-term {
      chunks.push(term)
      term = []
    }
    term += child
    if literal == none or literal.trim() != "" { has-term = true }
  }
  chunks.push(term)
  chunks.map(term => box([#math.equation(term) <math-term>])).join(h(0.2em))
}

